# Files and directories to exclude from Render deployment
# Reducing build size speeds up deployment and startup

# Version control
.git
.gitignore
.github

# Python
__pycache__
*.pyc
*.pyo
*.pyd
.Python
*.egg-info
dist
build
*.egg

# Testing
.pytest_cache
.coverage
htmlcov
.tox

# Development
.venv
venv
env
.vscode
.idea
*.swp
*.swo
*.swn
.DS_Store

# Large datasets (if present locally)
Dataset/
datasets/
large_files/

# Jupyter and notebooks
*.ipynb
.ipynb_checkpoints

# Documentation
docs/
.md

# Media files (use only what's needed)
*.mp4
*.mov
*.avi

# Cache files
.cache
*.cache
node_modules

# Temporary files
*.tmp
temp/
tmp/
