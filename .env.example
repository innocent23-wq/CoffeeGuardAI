# Copy this file to .env for local use. Never commit or upload the real .env.
SECRET_KEY=replace-with-a-long-random-value
SESSION_COOKIE_SECURE=false

# Performance and Render Deployment Settings
# For Render, set these to true for production:
FLASK_ENV=production
SESSION_COOKIE_SECURE=true

# Python optimization flags (for Render)
PYTHONUNBUFFERED=true
PYTHONDONTWRITEBYTECODE=true

# Gunicorn worker settings
WORKERS=4
WORKER_CLASS=sync
TIMEOUT=60
KEEP_ALIVE=5

# Model Configuration
# Optional absolute path for a mounted or externally supplied disease model.
# Leave blank to use the bundled decfia_best.onnx disease model.
MODEL_PATH=

# Hugging Face (for offline model caching)
HF_HOME=.model_cache
HF_HUB_OFFLINE=1

# Email Configuration (optional but recommended)
EMAIL_USER=
EMAIL_PASS=
FARMER_PHONE=

# News API (optional, for coffee farming news)
NEWS_API_KEY=

# Application Timezone
APP_TIMEZONE=Africa/Kampala

# Port (usually auto-set by Render)
PORT=5000
